generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== POND (replaces Zone) =====
model Pond {
  id              String     @id @default(cuid())
  type            PondType   @unique
  name_zh         String
  name_en         String
  name_th         String
  description_zh  String?
  description_en  String?
  description_th  String?
  price           Float
  priceUnit       PriceUnit
  minParticipants Int?
  maxSpots        Int
  imageUrl        String?
  isActive        Boolean    @default(true)
  spots           Spot[]
  bookings        Booking[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum PondType {
  LEISURE
  COMPETITION
}

enum PriceUnit {
  SLOT
  DAY
}

// ===== SPOT =====
model Spot {
  id        String    @id @default(cuid())
  pondId    String
  pond      Pond      @relation(fields: [pondId], references: [id])
  number    Int
  isActive  Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pondId, number])
}

// ===== USER =====
model User {
  id               String     @id @default(cuid())
  phone            String     @unique
  name             String
  language         String     @default("zh")
  marketingConsent Boolean    @default(false)
  bookings         Booking[]
  orders           Order[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ===== ADMIN USER =====
model AdminUser {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  role      AdminRole @default(MANAGER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

// ===== BOOKING =====
model Booking {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  pondId           String
  pond             Pond          @relation(fields: [pondId], references: [id])
  spotId           String?
  spot             Spot?         @relation(fields: [spotId], references: [id])
  date             DateTime      @db.Date
  timeSlot         TimeSlot?
  participantCount Int?
  groupName        String?
  customerName     String
  customerPhone    String
  totalPrice       Float
  status           BookingStatus @default(PENDING)
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([spotId, date, timeSlot])
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
  FULL_DAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ===== MENU =====
model MenuCategory {
  id       String     @id @default(cuid())
  name_zh  String
  name_en  String
  name_th  String
  type     MenuType
  imageUrl String?
  sortOrder Int       @default(0)
  isActive Boolean    @default(true)
  items    MenuItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MenuItem {
  id             String       @id @default(cuid())
  categoryId     String
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  name_zh        String
  name_en        String
  name_th        String
  description_zh String?
  description_en String?
  description_th String?
  price          Float
  imageUrl       String?
  imageThumbUrl  String?
  isPopular      Boolean      @default(false)
  isVegetarian   Boolean      @default(false)
  spiceLevel     Int          @default(0)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  // ----- 库存管理 -----
  stockType      StockType    @default(NONE)   // NONE=不管理 / MADE=自制 / PURCHASED=外购
  dailyLimit     Int?                          // 自制：每日限量（空=不限量）
  stockQty       Int?                          // 外购：当前库存（持久计数）
  lowStockAlert  Int?                          // 外购：低库存预警线
  costPrice      Float?                        // 成本价（用于毛利）
  targetMargin   Float?                        // 单品目标毛利率（0-1，空=用全局默认）
  soldOut        Boolean      @default(false)  // 手动强制售罄
  movements      StockMovement[]
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum MenuType {
  FOOD
  DRINK
}

enum StockType {
  NONE       // 不管理库存（默认可售）
  MADE       // 自制：每日限量，余量=限量−当日已售
  PURCHASED  // 外购：库存计数，可入库/损耗/调整
}

enum StockMovementType {
  PURCHASE  // 外购入库
  SALE      // 订单卖出（扣减）
  CANCEL    // 取消/拒单回补
  MANUAL    // 手动调整（盘点增减）
  WASTE     // 损耗 / 自用
}

// ===== STOCK MOVEMENT (库存流水，可对账) =====
model StockMovement {
  id        String            @id @default(cuid())
  itemId    String
  item      MenuItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int               // 带符号：正=入库/回补，负=扣减/损耗
  note      String?
  orderId   String?
  adminName String?
  createdAt DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
}

// ===== DINING TABLE (餐桌二维码点餐) =====
model DiningTable {
  id        String   @id @default(cuid())
  code      String   @unique        // A01–A10 (茅草屋), C01–C04 (咖啡厅) — QR短链用
  name_zh   String                  // 茅草屋 1号桌
  name_en   String                  // Hut Table 1
  name_th   String                  // ซุ้ม 1
  area      TableArea               // 区域：茅草屋 / 咖啡厅
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TableArea {
  HUT   // 茅草屋
  CAFE  // 咖啡厅
}

// ===== CLOSED DAY (休息日 / 法定假日) =====
// Monday is ALWAYS closed (hard-coded rule in lib/closed-days.ts).
// This model stores *additional* statutory holidays the admin adds.
model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason_zh String?
  reason_en String?
  reason_th String?
  createdAt DateTime @default(now())

  @@index([date])
}

// ===== ORDER & PAYMENT =====
model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  tableId       String?
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  customerName  String
  customerPhone String
  items         OrderItem[]
  bookings      Booking[]
  subtotal      Float
  totalPrice    Float
  note          String?
  orderType     OrderType     @default(DINE_IN)
  status        OrderStatus   @default(PENDING)
  payment       Payment?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  note       String?
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  CANCELLED
}

// ===== ORDER TYPE (点餐方式：堂食 / 外带) =====
enum OrderType {
  DINE_IN   // 堂食 — 必须绑定餐桌
  TAKEAWAY  // 外带 — 无桌号
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  amount        Float
  currency      String        @default("THB")
  omiseChargeId String?
  omiseSourceId String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PaymentMethod {
  PROMPTPAY
  TRUEMONEY
  BANK_TRANSFER
  CREDIT_CARD
  ALIPAY
  WECHAT_PAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
}
