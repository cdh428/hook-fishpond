generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== POND (replaces Zone) =====
model Pond {
  id              String     @id @default(cuid())
  type            PondType   @unique
  name_zh         String
  name_en         String
  name_th         String
  description_zh  String?
  description_en  String?
  description_th  String?
  price           Float
  priceUnit       PriceUnit
  minParticipants Int?
  maxSpots        Int
  imageUrl        String?
  isActive        Boolean    @default(true)
  spots           Spot[]
  bookings        Booking[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum PondType {
  LEISURE
  COMPETITION
}

enum PriceUnit {
  SLOT
  DAY
}

// ===== SPOT =====
model Spot {
  id        String    @id @default(cuid())
  pondId    String
  pond      Pond      @relation(fields: [pondId], references: [id])
  number    Int
  isActive  Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pondId, number])
}

// ===== USER =====
model User {
  id               String     @id @default(cuid())
  phone            String     @unique
  name             String
  language         String     @default("zh")
  marketingConsent Boolean    @default(false)
  bookings         Booking[]
  orders           Order[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ===== ADMIN USER =====
model AdminUser {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  role      AdminRole @default(MANAGER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

// ===== BOOKING =====
model Booking {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  pondId           String
  pond             Pond          @relation(fields: [pondId], references: [id])
  spotId           String?
  spot             Spot?         @relation(fields: [spotId], references: [id])
  date             DateTime      @db.Date
  timeSlot         TimeSlot?
  participantCount Int?
  groupName        String?
  customerName     String
  customerPhone    String
  totalPrice       Float
  status           BookingStatus @default(PENDING)
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([spotId, date, timeSlot])
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
  FULL_DAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ===== MENU =====
model MenuCategory {
  id       String     @id @default(cuid())
  name_zh  String
  name_en  String
  name_th  String
  type     MenuType
  imageUrl String?
  sortOrder Int       @default(0)
  isActive Boolean    @default(true)
  items    MenuItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MenuItem {
  id             String       @id @default(cuid())
  categoryId     String
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  name_zh        String
  name_en        String
  name_th        String
  description_zh String?
  description_en String?
  description_th String?
  price          Float
  imageUrl       String?
  imageThumbUrl  String?
  isPopular      Boolean      @default(false)
  isVegetarian   Boolean      @default(false)
  spiceLevel     Int          @default(0)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  // ----- 库存管理 -----
  stockType      StockType    @default(NONE)   // NONE=不管理 / MADE=自制 / PURCHASED=外购
  dailyLimit     Int?                          // 自制：每日限量（空=不限量）
  stockQty       Int?                          // 外购：数量账余额（= Σ分录 quantity，只由过账引擎维护）
  stockValue     Float?                        // 外购：金额账余额（= Σ分录 amount，只由过账引擎维护）
  avgCost        Float?                        // 外购：移动加权平均成本（= stockValue / stockQty）
  lowStockAlert  Int?                          // 外购：低库存预警线
  costPrice      Float?                        // 参考成本价（仅用于估算毛利；入账成本以 avgCost 为准）
  targetMargin   Float?                        // 单品目标毛利率（0-1，空=用全局默认）
  soldOut        Boolean      @default(false)  // 手动强制售罄
  movements      StockMovement[]
  receiptLines   PurchaseReceiptLine[]
  takeLines      StockTakeLine[]
  orderItems     OrderItem[]
  optionGroups   MenuItemOptionGroup[]  // 规格 / 面型 / 加料 等可选项
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ===== 菜品选项（规格 / 面型 / 加料 …） =====
// 一个菜品下挂若干个「选项组」，每个组里若干个「选项」。
// 组可设为必选/单选（份量、面型）或多选（加料）；选项可带加价。
// 选项加价只影响单价，不影响库存口径——扣库存仍按菜品自身数量。
model MenuItemOptionGroup {
  id            String              @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name_zh       String
  name_en       String
  name_th       String
  selectionType OptionSelectionType @default(SINGLE)
  isRequired    Boolean             @default(false)
  maxSelect     Int?                // MULTI 的勾选上限（空=不限）
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  options       MenuItemOption[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([menuItemId, sortOrder])
}

model MenuItemOption {
  id         String              @id @default(cuid())
  groupId    String
  group      MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name_zh    String
  name_en    String
  name_th    String
  priceDelta Float               @default(0)  // 加价（可为 0 或负数）
  isDefault  Boolean             @default(false)
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([groupId, sortOrder])
}

enum OptionSelectionType {
  SINGLE  // 单选（份量、面型）
  MULTI   // 多选（加料）
}

enum MenuType {
  FOOD
  DRINK
  TOOL   // 工具/用具（钓具、鱼饵等非餐饮商品），第三个菜单页签
}

enum StockType {
  NONE       // 不管理库存（默认可售）
  MADE       // 自制：每日限量，余量=限量−当日已售
  PURCHASED  // 外购：库存计数，可入库/损耗/调整
}

enum StockMovementType {
  PURCHASE  // 外购入库
  SALE      // 订单卖出（扣减）
  CANCEL    // 取消/拒单回补
  MANUAL    // 手动调整（盘点增减 / 期初对齐）
  WASTE     // 损耗 / 自用
}

// 分录挂靠的业务单据类型（凭证字）
enum StockDocType {
  PURCHASE_RECEIPT  // 🧾 进货单
  STOCK_TAKE        // 📋 盘点单
  ORDER             // 🍽️ 订单（销售/回补）
  MANUAL            // ✋ 手工调整
  OPENING           // 🏁 期初对齐
}

// ===== STOCK MOVEMENT (库存分录 —— 不可变台账，只允许 INSERT) =====
//
// 会计口径：
//  - 符号即借贷方向，quantity 正 = 入库（借：存货），负 = 出库（贷：存货）。
//  - 金额与数量成对记录：amount 正 = 存货金额增加，负 = 转出。
//  - 改错一律「红字冲销」：新增一条反向分录并用 reversalOf 指回原分录，
//    历史分录永不修改/删除（数据库触发器强制 append-only）。
//  - balanceAfter 记录过账后的数量账余额，便于逐笔对账。
model StockMovement {
  id             String            @id @default(cuid())
  itemId         String
  item           MenuItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Int               // 带符号：正=入库/回补，负=出库/扣减/损耗
  unitCost       Float?            // 本次单价（入库=进货价；出库=移动加权成本快照）
  amount         Float?            // 金额（带符号，与 quantity 同向）：正=金额流入存货
  balanceAfter   Int?              // 过账后的数量账余额（外购才有）
  docType        StockDocType?     // 单据类型
  docId          String?           // 单据 id（进货单 / 盘点单 / 订单）
  reversalOf     String?           // 冲销指针：本条是某条分录的红字冲销
  idempotencyKey String?           @unique  // 幂等键：同一业务只允许过账一次
  note           String?
  orderId        String?
  adminName      String?
  createdAt      DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([docType, docId])
  @@index([reversalOf])
}

// ===== 进货单（凭证头 + 明细）=====
// 一张单可以进多个菜品，形成一组有共同单据号的分录；
// 作废单据 = 生成一组反向分录（reversalOf 指回原分录），原分录不动。
model PurchaseReceipt {
  id          String                @id @default(cuid())
  code        String                @unique   // RC-YYYYMMDD-001
  supplier    String?                         // 供应商（可空）
  docDate     DateTime              @default(now())
  totalAmount Float                 @default(0) // 单据金额合计
  note        String?
  adminName   String?
  lines       PurchaseReceiptLine[]
  reversedAt  DateTime?                       // 已作废时刻（非空表示本单已冲销）
  createdAt   DateTime              @default(now())

  @@index([docDate])
}

model PurchaseReceiptLine {
  id         String          @id @default(cuid())
  receiptId  String
  receipt    PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  qty        Int             // 恒正
  unitCost   Float           // 进货单价
  amount     Float           // = qty × unitCost
  createdAt  DateTime        @default(now())

  @@index([receiptId])
  @@index([menuItemId])
}

// ===== 盘点单（凭证头 + 明细）=====
// 录入实盘数，系统按「实盘 − 账面」自动生成盘盈/盘亏分录。
model StockTake {
  id        String         @id @default(cuid())
  code      String         @unique   // ST-YYYYMMDD-001
  note      String?
  adminName String?
  lines     StockTakeLine[]
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

model StockTakeLine {
  id          String    @id @default(cuid())
  takeId      String
  take        StockTake @relation(fields: [takeId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  bookQty     Int       // 账面数（盘点时刻）
  actualQty   Int       // 实盘数
  diff        Int       // 实盘 − 账面（正=盘盈，负=盘亏）
  createdAt   DateTime  @default(now())

  @@index([takeId])
  @@index([menuItemId])
}

// ===== DINING TABLE (餐桌二维码点餐) =====
model DiningTable {
  id        String   @id @default(cuid())
  code      String   @unique        // A01–A10 (茅草屋), C01–C04 (咖啡厅) — QR短链用
  name_zh   String                  // 茅草屋 1号桌
  name_en   String                  // Hut Table 1
  name_th   String                  // ซุ้ม 1
  area      TableArea               // 区域：茅草屋 / 咖啡厅
  isActive  Boolean  @default(true)
  orders    Order[]
  serviceCalls ServiceCall[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== 呼叫服务（桌上按钮 → 后台提示） =====
model ServiceCall {
  id        String            @id @default(cuid())
  tableId   String?
  table     DiningTable?      @relation(fields: [tableId], references: [id])
  tableCode String                          // 冗余存桌号，方便后台直接显示
  type      ServiceCallType   @default(ASSISTANCE)
  status    ServiceCallStatus @default(PENDING)
  note      String?
  handledBy String?
  handledAt DateTime?
  createdAt DateTime          @default(now())

  @@index([status, createdAt])
}

enum ServiceCallType {
  ASSISTANCE  // 需要服务员
  WATER       // 加水
  TISSUE      // 纸巾 / 餐具
  BILL        // 请结账
}

enum ServiceCallStatus {
  PENDING       // 待处理
  ACKNOWLEDGED  // 已响应（人在路上）
  DONE          // 已完成
}

enum TableArea {
  HUT   // 茅草屋
  CAFE  // 咖啡厅
}

// ===== CLOSED DAY (休息日 / 法定假日) =====
// Monday is ALWAYS closed (hard-coded rule in lib/closed-days.ts).
// This model stores *additional* statutory holidays the admin adds.
model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason_zh String?
  reason_en String?
  reason_th String?
  createdAt DateTime @default(now())

  @@index([date])
}

// ===== ORDER & PAYMENT =====
model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  tableId       String?
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  customerName  String
  customerPhone String
  items         OrderItem[]
  bookings      Booking[]
  weighings     Weighing[]
  subtotal      Float         // 菜品小计（不含渔获、不含折扣）
  totalPrice    Float         // 应付净额 = subtotal + fishCharge − discountAmount
  note          String?
  orderType     OrderType     @default(DINE_IN)
  // 外带：顾客指定的取餐时间（堂食为空）。后厨据此排单，小票上也会打出来。
  pickupAt      DateTime?
  status        OrderStatus   @default(PENDING)
  // ----- 结算方式：先付 / 后付（用完后统一结算） -----
  settlementMode SettlementMode @default(POSTPAID)
  // ----- 渔获称重（前 1kg 免费，超出部分 60฿/kg） -----
  fishWeightKg  Float         @default(0)
  fishCharge    Float         @default(0)
  // ----- 折扣 / 改价（可审计：原价、折扣、实收三者都留痕） -----
  discountType  DiscountType  @default(NONE)
  discountValue Float         @default(0)   // PERCENT=百分比(0-100) / AMOUNT=固定减免金额
  discountAmount Float        @default(0)   // 实际减免的泰铢金额（正数=减免）
  discountNote  String?                     // 折扣原因（必填，便于对账）
  adjustedBy    String?                     // 最后改价/折扣操作人（管理员用户名）
  adjustedAt    DateTime?
  // ----- 结算与库存消耗时点 -----
  stockConsumedAt DateTime?   // 预占转正式扣减的时刻（先付=付款到账，后付=结清）
  settledAt     DateTime?     // 账单结清时刻（status=SETTLED）
  payment       Payment?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  // 下单即预占的数量（不改变 stockQty、不写流水）；结算时预占转正式扣减后归零
  reservedQty Int      @default(0)
  // ----- 选项快照（规格 / 面型 / 加料）-----
  // 存三语名称与加价快照：选项日后改名或删除，历史订单仍如实还原。
  options     Json?
  // 行匹配键 = menuItemId + '|' + 升序 optionId 列表。后台改单靠它区分
  // 「同菜品不同规格」的独立行，不能再用 menuItemId 单独匹配。
  optionKey   String?
  note        String?
  createdAt   DateTime @default(now())
}

// ===== 渔获称重记录（可多次称重，便于追溯与对账） =====
// 免费额度（前 1kg）在**订单层面**统一扣除，因此这里只记录毛重与毛额快照。
model Weighing {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  weightKg   Float
  pricePerKg Float    @default(60)   // 超出部分单价快照
  amount     Float                   // 本条毛额快照 = weightKg * pricePerKg（不含免费额度）
  note       String?
  operator   String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING    // 已下单，待后厨处理
  PAID       // 旧版：已付款（历史数据保留，新流程不再写入）
  PREPARING  // 备餐中
  READY      // 已备好
  SERVED     // 已送出给客户
  SETTLED    // 已结清（终态）
  CANCELLED  // 已取消
}

// ===== 结算方式（顾客下单时自选） =====
enum SettlementMode {
  PREPAID   // 立即付款
  POSTPAID  // 最后结算（用完后统一结清）
}

// ===== 折扣类型 =====
enum DiscountType {
  NONE
  PERCENT   // 按比例打折
  AMOUNT    // 固定金额减免
}

// ===== ORDER TYPE (点餐方式：堂食 / 外带) =====
enum OrderType {
  DINE_IN   // 堂食 — 必须绑定餐桌
  TAKEAWAY  // 外带 — 无桌号
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  amount        Float
  currency      String        @default("THB")
  omiseChargeId String?
  omiseSourceId String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PaymentMethod {
  CASH        // 现金（收银台当面收款）
  PROMPTPAY
  TRUEMONEY
  BANK_TRANSFER
  CREDIT_CARD
  ALIPAY
  WECHAT_PAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
}

// ===== LINE 日报接收人 =====
// 由 /api/webhooks/line 自动捕获：谁给官方账号发消息，就把谁记下来，
// 之后日报推给他。targetId 是 LINE 的 userId / groupId / roomId，
// 不是官方账号自己的 @ID。
model LineTarget {
  id          String         @id @default(cuid())
  targetId    String         @unique
  targetType  LineTargetType @default(USER)
  displayName String?        // 从 LINE 拉到的昵称 / 群名
  note        String?        // 管理员备注
  isActive    Boolean        @default(true)
  boundAt     DateTime       @default(now())
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum LineTargetType {
  USER
  GROUP
  ROOM
}

