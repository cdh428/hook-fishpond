# ============================================================
# 乐钓鱼塘 (Hook Fishpond) — 环境变量模板
# ============================================================
# 复制此文件为 .env.local，然后填入真实 Key
# cp .env.example .env.local
# ============================================================

# ---- 数据库 (Neon PostgreSQL — 主库) ----
# Neon: 永不停机, IPv4 直连, Prisma 兼容
# 去 Neon Dashboard → Connection Details → Direct Connection (psql)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>.aws.neon.tech/neondb?sslmode=require"

# ---- Supabase (冷备库) ----
# 仅备份脚本用（GitHub Actions 每日 pg_dump Neon → Supabase）
SUPABASE_DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres"
SUPABASE_PUBLISHABLE_KEY="<YOUR-SUPABASE-PUBLISHABLE-KEY>"

# ---- 网站基础 URL ----
# 本地开发用 localhost；生产固定为真实域名（canonical / og:url / 分享链接都用它）
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# 生产值：https://hookfishpond.com

# ---- LINE Messaging API（每日经营日报推给管理员）----
# LINE Developers → 你的 Provider → Messaging API 渠道
# 推送目标（好友 userId / 群 groupId）由 /api/webhooks/line 收到消息时自动登记；
# ⚠️ 目标不能填官方账号 @ID，必须是加过好友的个人或群。
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# ---- LINE Login（顾客 OTP，方案已定、待接入）----
# ⚠️ LINE Login 渠道必须建在**与上面 Messaging 渠道同一个 Provider** 下
#    （userId 按 Provider 签发，渠道建好后不能迁移）
# 另需在渠道里开 OpenID Connect，并把 Linked LINE Official Account 指到官方账号。
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# ---- Omise 支付 (泰国 Opn Payments) ----
# 去 https://dashboard.omise.co/ → Keys
# 测试模式用 Test Keys，上线后换 Live Keys
OMISE_PUBLIC_KEY="<YOUR-OMISE-PUBLIC-KEY>"
OMISE_SECRET_KEY="<YOUR-OMISE-SECRET-KEY>"

# ---- Omise 回调（webhook）密钥 ----
# 必须配置，否则 /api/webhooks/omise 直接返回 503（防止匿名伪造收款/改订单）。
# 配置后，Omise 后台的回调地址要带 ?token=<该值>：
#   https://<域名>/api/webhooks/omise?token=<OMISE_WEBHOOK_SECRET>
# 也可以放在请求头 x-omise-webhook-secret。
# 未接 Omise 时留空即可（接口保持停用）。
OMISE_WEBHOOK_SECRET=""

# ---- 定时任务密钥（Vercel Cron 鉴权）----
# Vercel Cron 会带 Authorization: Bearer <CRON_SECRET> 调用 /api/cron/*；
# 未配置时这些接口只接受后台管理员会话。
# 用 `openssl rand -base64 32` 生成。
CRON_SECRET=""

# ---- 管理员会话签名密钥（HMAC）----
# 后台 cookie 是签名 token，用它算 HMAC。未配置时退回用 DATABASE_URL 当密钥
# （能跑，但**建议显式配一个**）。
# 换掉这个值 = 一次性踢掉所有管理员会话，这是预期的应急手段。
# 用 `openssl rand -base64 32` 生成。
ADMIN_SESSION_SECRET=""

# ---- seed 用的管理员初始口令（仅在跑 prisma db seed 时读取）----
# ⚠️ 不再把口令写死在源码里（仓库是 public）。
# 生产环境跑 seed 时**必须**设这个值，否则直接报错退出。
# 只创建一次；已存在同名管理员时不会覆盖（改口令需手动 UPDATE）。
SEED_ADMIN_PASSWORD=""

# ---- 商家 PromptPay 收款号 ----
# 顾客扫码付款的 PromptPay ID（手机号或 13 位税号），缺省为占位号
PROMPTPAY_ID="0812345678"
