# ============================================================
# 乐钓鱼塘 (Hook Fishpond) — 环境变量模板
# ============================================================
# 复制此文件为 .env.local，然后填入真实 Key
# cp .env.example .env.local
# ============================================================

# ---- 数据库 (Supabase PostgreSQL) ----
# 去 Supabase Dashboard → Project Settings → Database → Connection string
# 选 URI 模式，勾选 "Use connection pooling"
DATABASE_URL="postgresql://postgres:<YOUR-DB-PASSWORD>@db.<YOUR-PROJECT-REF>.supabase.co:6543/postgres?pgbouncer=true"

# Direct URL（Prisma migrate 必须用直连，端口 5432）
DIRECT_URL="postgresql://postgres:<YOUR-DB-PASSWORD>@db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres"

# ---- Supabase Client ----
# 去 Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<YOUR-PROJECT-REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR-ANON-KEY>"

# ---- 网站基础 URL ----
# 本地开发用 localhost，部署后换成真实域名
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---- Omise 支付 (泰国 Opn Payments) ----
# 去 https://dashboard.omise.co/ → Keys
# 测试模式用 Test Keys，上线后换 Live Keys
OMISE_PUBLIC_KEY="<YOUR-OMISE-PUBLIC-KEY>"
OMISE_SECRET_KEY="<YOUR-OMISE-SECRET-KEY>"
